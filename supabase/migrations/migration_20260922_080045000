create policy "activity_photos_update_uploader_or_admin" on public.activity_photos
for update to authenticated
using (public.is_approved_member() and (uploaded_by = auth.uid() or public.is_family_admin()))
with check (public.is_approved_member() and (uploaded_by = auth.uid() or public.is_family_admin()));

create policy "activity_photos_delete_uploader_or_admin" on public.activity_photos
for delete to authenticated
using (public.is_approved_member() and (uploaded_by = auth.uid() or public.is_family_admin()));

create policy "activity_participants_select_members" on public.activity_participants
for select to authenticated
using (public.is_approved_member());

create policy "activity_participants_insert_members" on public.activity_participants
