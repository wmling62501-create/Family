-- ============================================================
-- 家族活動紀錄網站：資料表、權限（RLS）、邀請碼機制
-- 目標 Cloud 已確認為空白（無 public 資料表、無 bucket）
-- ============================================================
create extension if not exists pgcrypto;

-- updated_at 共用觸發器
create or replace function public.set_updated_at()
returns trigger
language plpgsql
as $$
begin
  new.updated_at = now();
  return new;
end;
$$;

-- ------------------------------------------------------------
-- 1. family_members 家族成員（名錄 + 家族樹來源）
-- ------------------------------------------------------------
create table public.family_members (
  id uuid primary key default gen_random_uuid(),
  full_name text not null,
  gender text not null default 'other' check (gender in ('male', 'female', 'other')),
  birth_date date,
  death_date date,
  parent_id uuid references public.family_members(id) on delete set null,
  spouse_id uuid references public.family_members(id) on delete set null,
  photo_url text,
  bio text,
  profile_id uuid,
  sort_order integer not null default 0,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create index family_members_parent_id_idx on public.family_members (parent_id);
create index family_members_spouse_id_idx on public.family_members (spouse_id);

create trigger family_members_set_updated_at
before update on public.family_members
for each row execute function public.set_updated_at();

-- 防止自我參照與循環血親
create or replace function public.validate_family_member_links()
returns trigger
language plpgsql
as $$
declare
  v_cursor uuid;
  v_guard integer := 0;
begin
  if new.parent_id = new.id then
    raise exception 'A family member cannot be their own parent';
  end if;
  if new.spouse_id = new.id then
    raise exception 'A family member cannot be their own spouse';
  end if;

  if new.parent_id is not null then
    v_cursor := new.parent_id;
    while v_cursor is not null and v_guard < 200 loop
      if v_cursor = new.id then
        raise exception 'Circular ancestry is not allowed';
      end if;
      select parent_id into v_cursor from public.family_members where id = v_cursor;
      v_guard := v_guard + 1;
    end loop;
  end if;

  return new;
end;
$$;

create trigger family_members_validate_links
before insert or update of parent_id, spouse_id on public.family_members
for each row execute function public.validate_family_member_links();

-- ------------------------------------------------------------
-- 2. profiles 使用者檔案（與登入帳號一對一）
-- ------------------------------------------------------------
create table public.profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  display_name text,
  avatar_url text,
  role text not null default 'member' check (role in ('admin', 'member')),
  is_approved boolean not null default false,
  family_member_id uuid references public.family_members(id) on delete set null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create trigger profiles_set_updated_at
before update on public.profiles
for each row execute function public.set_updated_at();

alter table public.family_members
  add constraint family_members_profile_id_fkey
  foreign key (profile_id) references public.profiles(id) on delete set null;

-- 權限判斷（security definer，避免 RLS 遞迴）
create or replace function public.is_approved_member()
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select exists (
    select 1 from public.profiles
    where id = auth.uid() and is_approved
  );
$$;

create or replace function public.is_family_admin()
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select exists (
    select 1 from public.profiles
    where id = auth.uid() and is_approved and role = 'admin'
  );
$$;

-- 註冊時自動建立 profile；第一位註冊者成為管理員
create or replace function public.handle_new_user()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
declare
  v_is_first boolean;
begin
  select not exists (select 1 from public.profiles) into v_is_first;

  insert into public.profiles (id, display_name, role, is_approved)
  values (
    new.id,
    coalesce(new.raw_user_meta_data ->> 'display_name', split_part(new.email, '@', 1)),
    case when v_is_first then 'admin' else 'member' end,
    v_is_first
  )
  on conflict (id) do nothing;

  return new;
end;
$$;

create trigger on_auth_user_created
after insert on auth.users
for each row execute function public.handle_new_user();

-- 一般成員不得自行升權
create or replace function public.prevent_role_escalation()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
begin
  if new.role is distinct from old.role and not public.is_family_admin() then
    raise exception 'Only a family admin can change a member role';
  end if;
  if new.is_approved is distinct from old.is_approved and not public.is_family_admin() then
    raise exception 'Only a family admin can change approval status';
  end if;
  return new;
end;
$$;

create trigger profiles_prevent_role_escalation
before update on public.profiles
for each row execute function public.prevent_role_escalation();

