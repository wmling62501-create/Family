-- 3. activities 活動紀錄
-- ------------------------------------------------------------
create table public.activities (
  id uuid primary key default gen_random_uuid(),
  title text not null,
  description text,
  activity_date date not null,
  location text,
  category text not null default 'gathering'
    check (category in ('gathering', 'trip', 'festival', 'wedding', 'memorial', 'birthday', 'other')),
  cover_image_url text,
  created_by uuid not null default auth.uid() references auth.users(id) on delete set null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create index activities_activity_date_idx on public.activities (activity_date desc);
create index activities_category_idx on public.activities (category);

create trigger activities_set_updated_at
before update on public.activities
for each row execute function public.set_updated_at();

